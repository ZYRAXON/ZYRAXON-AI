{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "paths": {
      /*
        The following two serve different purposes:
         - @foo/* is for importing types only,
         - .../lib/* means require dependency
      */
      "@dashboard/*": ["./packages/dashboard/src/*"],
      "@trace-viewer/*": ["./packages/trace-viewer/src/*"],
      "@html-reporter/*": ["./packages/html-reporter/src/*"],
      "@injected/*": ["./packages/injected/src/*"],
      "@isomorphic/*": ["./packages/isomorphic/*"],
      "@utils/*": ["./packages/utils/*"],
      "@protocol/*": ["./packages/protocol/src/*"],
      "@recorder/*": ["./packages/recorder/src/*"],
      "@testIsomorphic/*": ["./packages/jarvis/src/isomorphic/*"],
      "@trace/*": ["./packages/trace/src/*"],
      "@web/*": ["./packages/web/src/*"],
      "jarvis-browser-core/lib/*": ["./packages/jarvis-browser-core/src/*"],
      "jarvis/lib/*": ["./packages/jarvis/src/*"],
      "@jarvis/*": ["./packages/jarvis/src/*"],
    },
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "allowJs": false,
    "jsx": "react-jsx",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "noImplicitOverride": true,
    "useUnknownInCatchVariables": false,
    "useDefineForClassFields": false,
    "skipLibCheck": true,
  },
  "compileOnSave": true,
  "include": ["packages"],
  "exclude": [
    "packages/*/lib",
    "packages/extension",
    "packages/jarvis-browser-core/src/tools/skills",
  ]
}
